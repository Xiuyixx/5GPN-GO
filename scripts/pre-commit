#!/usr/bin/env bash
# Install with: make install-hooks
#
# Local git pre-commit hook that runs the M4 file-size guard against
# whatever is currently staged. Fast (~ms); does not run tests or build.
# `dirname` on this file may return .git/hooks/ (invoked via a symlink),
# so resolve the real script location via git's toplevel.

set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-file-size.sh" --staged
